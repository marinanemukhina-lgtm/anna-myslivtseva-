# npm run setup создаёт хеш пароля для локального запуска.
ADMIN_PASSWORD_HASH=
# Для Vercel: строка подключения Neon Postgres; локально используется SQLite.
DATABASE_URL=
# Приём номеров выключен. Не включать до отдельного подтверждения полного контура.
CONTACT_CALLBACK_ENABLED=false
CONTACT_CALLBACK_DATA_APPROVED=false
# SHA-256 точной опубликованной privacy + callbackConsent; пусто до утверждения.
# Это техническое подтверждение выпуска, не проверка юридической корректности.
CONTACT_CALLBACK_RELEASE_VERSION=
