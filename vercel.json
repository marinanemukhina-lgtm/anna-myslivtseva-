{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/client/index.html"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/index\\.html",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "/",
      "dest": "/api"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "prep/anonymous-busy-windows-20261105": false,
      "prep/owner-invitation-20261105": false
    }
  }
}
